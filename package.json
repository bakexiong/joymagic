    "type": "git",
    "url": ""
  },
  "keywords": [
    "10b.ai",
    "10b.ai ai",
    "10b.ai",
    "Z-Image-Turbo"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:web": "next dev",
    "dev:agent": "node scripts/prepare-mastra-studio.mjs && MASTRA_TELEMETRY_DISABLED=1 pnpm exec mastra dev --dir src/mastra --root . --env .env.agent.development",
    "mastra:studio": "node scripts/prepare-mastra-studio.mjs && MASTRA_TELEMETRY_DISABLED=1 pnpm exec mastra studio --env .env.agent.development --port 4111 --server-host 127.0.0.1 --server-port 4112 --server-protocol http --server-api-prefix /api",
    "mastra:studio:debug": "node scripts/prepare-mastra-studio.mjs && MASTRA_TELEMETRY_DISABLED=1 pnpm exec mastra studio --env .env.agent.development --port 4111 --server-host 127.0.0.1 --server-port 4112 --server-protocol http --server-api-prefix /api",
    "build": "next build",
    "build:fast": "NODE_OPTIONS='--max-old-space-size=4096' next build --webpack",
    "start": "next start",
    "build:agent": "node scripts/prepare-mastra-studio.mjs && MASTRA_TELEMETRY_DISABLED=1 pnpm exec mastra build --dir src/mastra --root . --studio",
    "start:agent": "MASTRA_TELEMETRY_DISABLED=1 pnpm exec mastra start --env .env.agent.development",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:posts": "tsx scripts/sync-strapi-posts.ts",
    "sync:gpt-image-2-samples": "tsx scripts/sync-gpt-image-2-text-to-image-samples.ts",
    "sync:gpt-image-2-text-samples": "tsx scripts/sync-gpt-image-2-text-to-image-samples.ts",
    "sync:image-effect-samples": "tsx scripts/generate-image-effect-samples.ts",
    "generate:mango-photo-effects": "tsx scripts/generate-mango-photo-effect-samples.ts",
    "sync:mango-photo-effects": "tsx scripts/sync-mango-photo-effects.ts --require-generated",
    "upload:image-effect-samples": "tsx scripts/upload-image-effect-samples-to-oss.ts",
    "sync:image-effects-pricing": "tsx scripts/sync-image-effects-pricing.ts",
    "db:generate": "npx drizzle-kit generate --config=src/core/db/config.ts",
    "db:migrate": "npx drizzle-kit migrate --config=src/core/db/config.ts",
    "db:push": "npx drizzle-kit push --config=src/core/db/config.ts",
    "db:studio": "npx drizzle-kit studio --config=src/core/db/config.ts",
    "auth:generate": "npx @better-auth/cli generate --config=src/core/auth/index.ts",
    "rbac:init": "npx tsx scripts/init-rbac.ts",
    "rbac:assign": "npx tsx scripts/assign-role.ts",
    "affiliate:release": "npx tsx scripts/release-affiliate-commissions.ts",
    "process:images": "npx tsx scripts/process-explore-images.ts",
    "postinstall": "fumadocs-mdx",
    "upload-service:railway": "tsx services/upload-service/src/node-server.ts",
    "upload-service:typecheck": "tsc --noEmit --pretty false",
    "prebuild": "pnpm sync:posts"
  },
