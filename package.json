{
  "name": "10b.ai",
  "version": "1.3.0",
  "private": true,
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.sass",
    "*.less"
  ],
  "author": "10b.ai",
  "homepage": "https://10b.ai",
