  },
  fantasy: {
    id: 'fantasy',
    sceneName: 'Fantasy',
    subtitle: 'Magic, mythology, sci-fi scenes',
    generateUrl: '/text-to-image?category=fantasy',
    order: 2,
  },
  nature: {
    id: 'nature',
    sceneName: 'Nature',
    subtitle: 'Mountains, oceans, forests, sunsets',
    generateUrl: '/text-to-image?category=nature',
    order: 3,
  },
  urban: {
    id: 'urban',
    sceneName: 'Urban',
    subtitle: 'Street photography, architecture, cyberpunk',
    generateUrl: '/text-to-image?category=urban',
    order: 4,
  },
  art: {
    id: 'art',
    sceneName: 'Art',
    subtitle: 'Oil painting, watercolor, illustration, concept art',
    generateUrl: '/text-to-image?category=art',
    order: 5,
  },
  animals: {
    id: 'animals',
    sceneName: 'Animals',
