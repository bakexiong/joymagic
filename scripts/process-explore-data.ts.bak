/**
 * 数据处理脚本：补全 + 重新分类
 *
 * 功能：
 * 1. 读取现有的 explore_page_config
 * 2. 补全必需字段（width, height, aspectRatio, likes, priority）
 * 3. 根据 prompt 关键词自动分类
 * 4. 输出新的分类结构
 *
 * 使用方法：
 * npx tsx scripts/process-explore-data.ts
 */

import { getConfigsDirectly } from '@/shared/models/config';
import { writeFileSync } from 'fs';
import { join } from 'path';

// ==================== 配置 ====================

// 分类元数据
const categoryMetadata = {
  portraits: {
